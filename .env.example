# --- Supabase (Project Settings -> Database / API) ---
# Copy it from Supabase > Connect > Session pooler (do not type the host by hand: it is region-specific).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<copy-host-from-supabase>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for projects still on the legacy HS256 JWT secret. New projects use JWKS automatically.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=applications

# The only account allowed to use the API.
ALLOWED_USER_EMAIL=you@example.com

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional JSON override of $/1M tokens, e.g. {"gpt-5": [1.25, 10.0]}
OPENAI_PRICES=

# --- More job sources (all optional; each is skipped until its key is set) ---
# Google Jobs via SerpApi (https://serpapi.com, free ~100 searches/month): LinkedIn/Indeed/Glassdoor listings
SERPAPI_API_KEY=
SERPAPI_MAX_QUERIES=3
# Brave Search API (https://brave.com/search/api, free ~2000/month): hiring posts across the web & discussions
BRAVE_API_KEY=
BRAVE_MAX_QUERIES=8
# Adzuna (https://developer.adzuna.com, free): countries it covers, comma-separated (no Nigeria; za = South Africa)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=gb,za
# Reddit app (https://www.reddit.com/prefs/apps, "script" type). Optional: public JSON is used without it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional integrations ---
HUNTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# --- App ---
WEB_ORIGIN=http://localhost:3000
SCHEDULER_ENABLED=true
DESKTOP_NOTIFICATIONS=true
