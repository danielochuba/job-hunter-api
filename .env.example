# --- Supabase (Project Settings -> Database / API) ---
# Copy it from Supabase > Connect > Session pooler (do not type the host by hand: it is region-specific).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<copy-host-from-supabase>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for projects still on the legacy HS256 JWT secret. New projects use JWKS automatically.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=applications

# The only account allowed to use the API.
ALLOWED_USER_EMAIL=you@example.com

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional JSON override of $/1M tokens, e.g. {"gpt-5": [1.25, 10.0]}
OPENAI_PRICES=

# --- Optional integrations ---
HUNTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# --- App ---
WEB_ORIGIN=http://localhost:3000
SCHEDULER_ENABLED=true
DESKTOP_NOTIFICATIONS=true
